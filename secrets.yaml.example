# Copy to secrets.yaml (which is gitignored) and fill in.
wifi_ssid: "your-wifi-name"
wifi_password: "your-wifi-password"
# Any string; ESPHome uses it to authenticate OTA updates to the satellites.
ota_password: "choose-an-ota-password"
# Home Assistant long-lived access token (profile > Security) for wake_verify's speech-to-text check.
ha_token: "paste-a-long-lived-access-token"
